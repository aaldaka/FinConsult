# copy to .env and replace every placeholder. .env is git-ignored, never commit it

# database (the postgres container and every service). POSTGRES_DB is optional, it defaults to finconsult
POSTGRES_DB=finconsult
DB_USERNAME=finconsult
DB_PASSWORD=change-me-db-password
POSTGRES_HOST_PORT=5433

# the same secret in every service. It must be standard Base64 of at least 32 bytes (the placeholder is not valid
# Base64 on purpose, the services refuse to start until it is replaced). Generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_EXPIRATION_MS=3600000

# the same key in every service, for their /internal/ calls to each other
INTERNAL_API_KEY=change-me-internal-key

# where the frontend runs, used in the links of verification and reset emails
APP_FRONTEND_URL=http://localhost:5173

# upload limits for kyc documents, certificates and profile pictures
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=30MB

# smtp for user-service emails. MAIL_HOST and MAIL_PORT are optional, they default to gmail (smtp.gmail.com:587)
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me-mail-app-password

# document-service: empty skips the virus scan; the delay slows each kyc check down for a demo, 0 means no pause
VIRUSTOTAL_API_KEY=
KYC_CHECK_DELAY_MS=0
DB_URL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080
